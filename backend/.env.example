# Copy to .env and adjust. Loaded by the API and by the Prisma CLI.

# development or production; production requires JWT_SECRET
NODE_ENV=development
# Port the API listens on
PORT=3000
# SQLite database, relative to backend/
DATABASE_URL=file:./data/tasks.db
# Secret used to sign access tokens, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty in development to use a random secret per process.
JWT_SECRET=
# Access token lifetime in seconds
JWT_EXPIRES_IN_SECONDS=3600
